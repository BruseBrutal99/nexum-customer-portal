# Supabase — brug gerne LEGACY keys (anon + service_role, starter med eyJ...)
# De nye sb_publishable_ / sb_secret_ nøgler giver ofte "Invalid API key"
# med supabase-js admin-kald (opret bruger/produkt).
#
# Find dem i: Supabase → Project Settings → API Keys → Legacy API keys
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...anon...
SUPABASE_SERVICE_ROLE_KEY=eyJ...service_role...

# Live purchase quotes from Nexum TMS (same engines as check-price)
# Keep a single local host for Nor Courier: http://localhost:3000
# PRICING_MODE=demo
PRICING_MODE=tms
TMS_QUOTE_API_URL=http://localhost:3001/api/portal/quote-costs
TMS_QUOTE_API_KEY=
# Optional override if quote URL is not under the same host:
# TMS_BOOKING_API_URL=http://localhost:3001

# Guest homepage markup % (higher than logged-in customer markups)
PUBLIC_GUEST_MARKUP_PCT=35

# Booking advisering (email/webhook)
PORTAL_BOOKING_NOTIFY_EMAIL=contact@norspedition.dk
# PORTAL_NOTIFY_WEBHOOK_URL=

# Optional live parcel tracking (falls back to carrier deeplinks if unset)
# DHL Tracking API: https://developer.dhl.com/
# DHL_TRACKING_API_KEY=
# UPS Tracking API (OAuth client credentials)
# UPS_CLIENT_ID=
# UPS_CLIENT_SECRET=
